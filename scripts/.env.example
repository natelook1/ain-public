# Frontend API base (leave blank to use production default)
VITE_API_BASE=

# SSE server base URL
# Local dev: http://localhost:3001
# Production: https://sse-ain.looknet.ca  (or whatever domain/port you expose)
VITE_SSE_BASE=

# SSE server — set these on the VPS, not in the frontend build
SSE_PUBLISH_SECRET=   # random secret shared between the SSE server and n8n
SSE_PORT=3001
CORS_ORIGIN=          # e.g. https://ain.looknet.ca
